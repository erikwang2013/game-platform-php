APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=game-platform
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=change-me-64-chars-random-string
SERVICE_JWT_SECRET_KEY=change-me-64-chars-random-string
JWT_TTL=7200

HASHIDS_SALT=change-me-to-random-salt
# 必须与 HASHIDS_SALT 不同，用于备用连接（fail-closed，缺失/默认值拒绝启动）
HASHIDS_ALT_SALT=change-me-to-a-different-random-salt
HASHIDS_ALPHABET=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890
HASHIDS_MIN_LENGTH=16

SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=2

ENCRYPTION_KEY=change-me-32-bytes-random-key
ENCRYPTABLE_KEY=change-me-to-random-aes-key

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

CORS_ORIGIN=*

# OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_REDIRECT_URI=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=
OAUTH_APPLE_REDIRECT_URI=

# Payment Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# 沙箱: https://api-sandbox.nowpayments.io
NOWPAYMENTS_API_URL=https://api.nowpayments.io
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
# 支付成功/取消跳转与回调地址基础域名
SITE_URL=https://example.com
PAYPAL_WEBHOOK_ID=
PAYPAL_VERIFY_URL=

# Skrill 电子钱包
SKRILL_API_URL=https://pay.skrill.com
SKRILL_API_KEY=
SKRILL_MERCHANT_ID=
# 回调验签密钥（md5sig，勿泄露）
SKRILL_SECRET_WORD=

# Neteller 电子钱包
NETELLER_API_URL=https://api.neteller.com
NETELLER_CLIENT_ID=
NETELLER_CLIENT_SECRET=
# 回调验签密钥（webhook body 的 key 字段比对）
NETELLER_SECRET=

# Paysafecard 预付卡
PAYSAFECARD_API_URL=https://api.paysafecard.com
PAYSAFECARD_API_KEY=
# 回调验签密钥（X-Signature: base64(HMAC-SHA256(secret, raw body))）
PAYSAFECARD_SECRET=

# Paytm（印度）
PAYTM_MID=
# 含特殊字符时须用双引号包裹（如 PAYTM_KEY="abc#123!@$"）
PAYTM_KEY=
# 测试环境 https://securegw-stage.paytm.in（以商户后台下发为准）
PAYTM_API_URL=https://securegw.paytm.in
# 正式 DEFAULT，staging 用 WEBSTAGING
PAYTM_WEBSITE=DEFAULT

# Mercado Pago（拉美）
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_API_URL=https://api.mercadopago.com

# AstroPay（拉美）
ASTROPAY_LOGIN=
ASTROPAY_API_KEY=
ASTROPAY_SECRET=
ASTROPAY_API_URL=https://api.astropaycard.com

# PayPay（日本）
PAYPAY_CLIENT_ID=
PAYPAY_CLIENT_SECRET=
# Webhook 验签密钥（PayPay-Signature: hash=<hex>,ts=<unix>）
PAYPAY_SIGNING_KEY=
PAYPAY_API_URL=https://api.paypay.ne.jp

# KakaoPay（韩国，无 Webhook，前端回传 pg_token 后调 approve API 验额）
KAKAOPAY_ADMIN_KEY=
KAKAOPAY_CID=
# 用户付款后跳转的审批 URL（前端拼接 order_no/transaction_id 后回传）
KAKAOPAY_APPROVAL_URL=
KAKAOPAY_API_URL=https://kapi.kakao.com

# GCash（菲律宾，经 PayMongo 渠道）
PAYMONGO_API_KEY=
# 回调验签密钥（Paymongo-Signature: t=<unix>,te/li=<hex>）
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_API_URL=https://api.paymongo.com/v1

# M-Pesa（肯尼亚，STK Push，无 Webhook 签名；安全边界 = CheckoutRequestID 命中 + 金额比对）
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# 沙箱须显式设 https://sandbox.safaricom.co.ke
MPESA_API_URL=https://api.safaricom.co.ke

# Paystack（尼日利亚）
PAYSTACK_SECRET_KEY=
PAYSTACK_API_URL=https://api.paystack.co

# Toss（韩国，无 Webhook 签名；安全边界 = 服务端 confirm/fetch 回查 + 金额比对）
TOSS_SECRET_KEY=
TOSS_API_URL=https://api.tosspayments.com

# PayPal 打款（PayoutService）
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox


CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=game-platform
CLICKHOUSE_USER=default
CLICKHOUSE_PASS=Aa123456


# ES 驱动: elasticsearch / opensearch / meilisearch
SCOUT_DRIVER=opensearch
# ES 主机地址，多节点逗号分隔
SCOUT_HOSTS=http://localhost:9200
# 索引名称前缀，与数据库表前缀一致
SCOUT_PREFIX=game_
# 索引分片数
SCOUT_SHARDS=1
# 索引副本数
SCOUT_REPLICAS=0
# 批量同步块大小
SCOUT_CHUNK_SIZE=500
# 软删除数据自动从索引移除
SCOUT_SOFT_DELETE=true


OPENSEARCH_HTTP_HOST=http://localhost:37831
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=Admin@123
OPENSEARCH_INDEX_PREFIX=game_
OPENSEARCH_SSL_VERIFICATION=false
OPENSEARCH_SSL_CERT=
OPENSEARCH_SSL_KEY=
OPENSEARCH_RETRIES=2
OPENSEARCH_CONNECTION_TIMEOUT=10
OPENSEARCH_TIMEOUT=30