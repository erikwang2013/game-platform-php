{
  "name": "erik/game-platform-service",
  "description": "全球游戏聚合平台 — C端业务端",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "workerman/webman-framework": "^2.1",
    "monolog/monolog": "^2.0",
    "erikwang2013/snowflake-php": "^2.0",
    "erikwang2013/hashids": "^1.0",
    "erikwang2013/jwt-webman": "^2.0",
    "erikwang2013/encryption": "^1.0",
    "erikwang2013/encryptable": "^2.0",
    "erikwang2013/webman-scout": "^2.0",
    "erikwang2013/season": "^2.0",
    "erikwang2013/poster-php": "^1.0",
    "erikwang2013/security-php": "^1.1",
    "guzzlehttp/guzzle": "^7.0",
    "vlucas/phpdotenv": "^5.6",
    "hg/apidoc": "^5.3",
    "hg/apidoc-export": "^1.0",
    "webman/validation": "^2.2",
    "illuminate/validation": "^11.51",
    "illuminate/events": "^11.51",
    "webman/database": "^2.1",
    "illuminate/pagination": "^11.51",
    "symfony/var-dumper": "^7.4",
    "webman/redis": "^2.1",
    "erik/platform-common": "dev-main",
    "aws/aws-sdk-php": "^3.394",
    "alibabacloud/cdn-20180510": "^9.1",
    "tencentcloud/tencentcloud-sdk-php": "^3.0",
    "huaweicloud/huaweicloud-sdk-php": "^3.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../packages/platform-common",
      "options": {
        "symlink": true
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app"
    },
    "exclude-from-classmap": [
      "common/service/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "./tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "erikwang2013/encryptable": true,
      "erikwang2013/webman-scout": true,
      "erikwang2013/encryption": true,
      "erikwang2013/security-php": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
