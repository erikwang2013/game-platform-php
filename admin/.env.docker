APP_NAME=开放管理后台
APP_DEBUG=false
APP_URL=http://localhost

# JWT (生产密钥务必修改)
JWT_SECRET_KEY=game-platform-in-production-use-64-char-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=game-platform
JWT_AUDIENCE=game-platform
JWT_DEFAULT_EXPIRE=7200
JWT_REFRESH_EXPIRE=1209600

HASHIDS_SALT=game-platform-hashids-salt-production
HASHIDS_ALT_SALT=game-platform-alt-salt-production

SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=1

ENCRYPTION_KEY=game-platform-32-byte-encryption-key!
ENCRYPTABLE_KEY=game-platform-32-byte-db-encrypt-key!

SCOUT_DRIVER=opensearch
SCOUT_HOSTS=http://opensearch:9200

#opensearch
OPENSEARCH_HTTP_HOST=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX_PREFIX=game_
OPENSEARCH_SSL_VERIFICATION=false
OPENSEARCH_SSL_CERT=
OPENSEARCH_SSL_KEY=
OPENSEARCH_RETRIES=2
OPENSEARCH_CONNECTION_TIMEOUT=10
OPENSEARCH_TIMEOUT=30


DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=game-platform
DB_USERNAME=root
DB_PASSWORD=root

REDIS_HOST=redis
REDIS_PORT=6379
